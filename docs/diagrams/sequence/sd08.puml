@startuml
!include ../style.iuml
autonumber
actor "Security Analyst" as A
boundary "Hybrid Verdict page\n(Module 6)" as UI
entity "Session state" as S
control "fusion\n(Module 10)" as F
A -> UI : open page
activate UI
UI -> S : get detection result, dynamic report
S --> UI : static result?, dynamic report?
alt neither available (UC-08 2b)
  UI --> A : what-if simulator only
else at least one available
  UI -> UI : static_evidence(result) → score, family
  UI -> F : fuse(static_conf, dynamic_score, w_static = 0.5, w_dynamic = 0.5)
  activate F
  F -> F : fused = weighted mean of available scores
  F -> F : category from high/low of each view
  F -> F : verdict (≥ 0.70 MALICIOUS, ≥ 0.40 SUSPICIOUS)
  opt category = NOVEL_VARIANT
    F -> F : escalate to at least SUSPICIOUS
  end
  F -> F : merge_mitre_sources(static, dynamic)
  F --> UI : FusionResult
  deactivate F
  UI -> S : store fusion result
  UI --> A : verdict, category, reason, MITRE by source
  opt download
    A -> UI : "Download hybrid report (JSON)"
  end
end
deactivate UI
@enduml
