@startuml
!include ../style.iuml
autonumber
actor "Security Analyst" as A
boundary "Detection page\n(Module 6)" as UI
control "inference\n(Module 5)" as INF
entity "MalTwinCNN" as CNN
control "db\n(Module 8)" as DB
database "SQLite" as SQL
control "mitre_mapper\n(Module 8)" as MM
A -> UI : click "Run Detection"
activate UI
alt no file uploaded (UC-03 1a)
  UI --> A : "Please upload a file on the Binary Upload page"
else no trained model (UC-03 2a)
  UI --> A : "No trained model is available…"
else file and model available
  UI -> INF : predict_single(model, image, class_names)
  activate INF
  INF -> INF : normalise to [-1, 1], add batch dimension
  INF -> CNN : forward(x)
  activate CNN
  CNN --> INF : logits (1 × N)
  deactivate CNN
  INF -> INF : softmax, top-1, top-3
  INF --> UI : family, confidence, probabilities
  deactivate INF
  UI -> DB : log_detection_event(sha256, family, confidence)
  activate DB
  DB -> SQL : INSERT INTO detection_events …
  alt write fails
    DB -> SQL : retry once
  end
  DB --> UI : (never raises)
  deactivate DB
  alt family = Benign (UC-03 3a)
    UI --> A : "classified Benign", no MITRE techniques
  else malware family
    UI -> MM : get_mitre_mapping(family)  «include» UC-04
    activate MM
    MM --> UI : tactics, techniques
    deactivate MM
    UI --> A : label, confidence bar, probability chart, MITRE table
  end
end
deactivate UI
@enduml
